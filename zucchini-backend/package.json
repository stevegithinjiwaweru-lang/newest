{
  "name": "zucchini-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "postinstall": "prisma generate || echo Prisma generate failed - run npx prisma generate manually when online",
    "start": "prisma migrate deploy && node dist/seed.js && node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "seed": "ts-node src/seed.ts",
    "clear-orders": "ts-node --project scripts/tsconfig.json scripts/clear-orders.ts",
    "e2e": "ts-node --project scripts/tsconfig.json scripts/e2e-workflow.ts",
    "cleanup-legacy": "ts-node --project scripts/tsconfig.json scripts/cleanup-legacy-order-numbers.ts",
    "migrate-legacy": "ts-node --project scripts/tsconfig.json scripts/migrate-legacy-orders.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.14.9",
    "@types/uuid": "^9.0.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "prisma": "^5.19.1",
    "socket.io": "^4.7.5",
    "typescript": "^5.5.3",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
