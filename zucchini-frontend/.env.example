# Local dev only. On Vercel, set these as service Variables (Vite bakes them in at build time).
# After changing VITE_* on Vercel, redeploy the frontend so the new values are compiled.
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# Production examples (Vercel):
# VITE_API_URL=https://api.easybox.ke/api
# VITE_SOCKET_URL=https://api.easybox.ke
