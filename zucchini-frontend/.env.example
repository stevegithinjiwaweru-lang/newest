# Local dev only. On Railway, set these as service Variables (Vite bakes them in at build time).
# After changing VITE_* on Railway, redeploy the frontend so the new values are compiled.
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# Production examples (Railway):
# VITE_API_URL=https://your-backend.up.railway.app/api
# VITE_SOCKET_URL=https://your-backend.up.railway.app
