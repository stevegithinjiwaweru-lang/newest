{
  "name": "easybox-rider-app",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "prebuild": "expo prebuild --clean",
    "configure": "eas build:configure",
    "build:android": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:apk": "eas build --platform android --profile preview --local",
    "build:apk:production": "eas build --platform android --profile production --local"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-camera-roll/camera-roll": "^7.4.0",
    "@react-native-community/geolocation": "^3.2.0",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "axios": "^1.7.2",
    "expo": "~51.0.39",
    "expo-camera": "~15.0.16",
    "expo-location": "~17.0.1",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-maps": "1.14.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/config": "~8.5.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.79",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~11.0.15",
    "jest": "^29.7.0",
    "typescript": "~5.3.3"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  }
}