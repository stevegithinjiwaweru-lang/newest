# ========================================
# Zucchini Rider App — Environment Config
# ========================================
# EXPO_PUBLIC_* are baked into the JS bundle at build time (EAS / Expo).
# After changing these, rebuild the APK (eas build).

# --- Production (Railway backend) ---
# Use the same public backend domain as the dispatcher dashboard (no /api suffix).
EXPO_PUBLIC_API_BASE_URL=https://YOUR-BACKEND.up.railway.app
EXPO_PUBLIC_SOCKET_URL=https://YOUR-BACKEND.up.railway.app

# --- Local development ---
# EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
# EXPO_PUBLIC_SOCKET_URL=http://localhost:4000
# On a physical device use your machine LAN IP, e.g. http://192.168.1.10:4000

EXPO_PUBLIC_LOCATION_UPDATE_INTERVAL_MS=10000
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
EXPO_PUBLIC_ENABLE_LOCATION_TRACKING=true
EXPO_PUBLIC_ENABLE_PHOTO_PROOF=true
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_BUILD_VERSION=1.0.0
EXPO_PUBLIC_BUILD_TYPE=production
EXPO_PUBLIC_LOG_LEVEL=info
